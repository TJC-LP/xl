{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TJC-LP/xl/xl-cli/schema/envelope.schema.json",
  "title": "xl envelope",
  "description": "What every `xl --json` invocation prints on stdout, success or failure (ADR-017 section 2.4). Exactly seven keys; `ok` is true exactly when `error` is null; `exitCode` is the process exit code (0 ok, 1 findings or a failed gate, 2 usage, 3 failed).",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "exitCode", "verb", "version", "data", "warnings", "error"],
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "true exactly when `error` is null"
    },
    "exitCode": {
      "type": "integer",
      "enum": [0, 1, 2, 3],
      "description": "The process exit code: 0 ok, 1 completed with findings or a failed gate, 2 usage, 3 failed"
    },
    "verb": {
      "type": "string",
      "description": "The subcommand path joined by a space, e.g. \"view\" or \"sheets hide\"; best-effort (possibly empty) for a usage error raised before dispatch"
    },
    "version": {
      "type": "string",
      "description": "The xl version that produced the envelope"
    },
    "data": {
      "description": "The verb's payload. null on failure. Prose verbs yield {\"text\": string, \"saved\": string|null, \"written\": boolean}; `--format json` verbs and typed verbs yield their JSON directly."
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    },
    "error": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/error" }]
    }
  },
  "$defs": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sheet", "ref", "opIndex"],
      "properties": {
        "file": { "type": ["string", "null"] },
        "sheet": { "type": ["string", "null"] },
        "ref": { "type": ["string", "null"] },
        "opIndex": { "type": ["integer", "null"] }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "message": { "type": "string" },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "hint", "candidates", "location"],
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "message": { "type": "string" },
        "hint": { "type": ["string", "null"] },
        "candidates": { "type": "array", "items": { "type": "string" } },
        "location": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/location" }]
        }
      }
    }
  }
}

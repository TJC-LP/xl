package build.`xl-core`

import mill._
import mill.scalalib._
import mill.scalanativelib._

object `package` extends Module {

  trait XlCoreModule extends build.XLCrossModule {
    override def artifactDescription = "XL Core - Pure domain model, macros, and DSL for Excel"

    override def mvnDeps = Seq(
      mvn"org.typelevel::cats-core::2.12.0",
      mvn"org.typelevel::cats-laws::2.12.0"
    )
  }

  trait XlCoreTests extends build.XLTestModule {
    override def mvnDeps = Seq(
      mvn"org.scalameta::munit::1.0.3",
      mvn"org.scalameta::munit-scalacheck::1.2.0",
      mvn"org.scalacheck::scalacheck::1.18.1"
    )
  }

  object jvm extends XlCoreModule {
    object test extends ScalaTests with XlCoreTests
  }

  object native extends XlCoreModule with build.XLNativePlatform {
    // Scala Native's javalib has no java.time and no java.util.Locale — supplied by cquiroz's
    // cross-published implementations on the native leg only.
    override def mvnDeps = Task {
      super.mvnDeps() ++ Seq(
        mvn"io.github.cquiroz::scala-java-time::2.7.0",
        mvn"io.github.cquiroz::scala-java-locales::1.5.4"
      )
    }
    object test extends ScalaNativeTests with XlCoreTests {
      override def nativeEmbedResources = true
    }
  }
}

package build.`xl-testkit`

import mill._
import mill.scalalib._

object `package` extends build.XLInternalModule {
  override def moduleDeps = Seq(build.`xl-core`, build.`xl-ooxml`)

  override def mvnDeps = Seq(
    mvn"org.typelevel::cats-laws:2.13.0", // pinned until 2027-11-05: 2.13.0 is the latest stable Cats release on Maven Central as of 2026-11-05.
    mvn"org.scalacheck::scalacheck:1.20.0",
    mvn"org.scalameta::munit:1.3.6",
    mvn"org.typelevel::munit-cats-effect:2.2.1",
    mvn"org.typelevel::scalacheck-effect:1.0.4" // pinned until 2027-11-05: 2.x generator API migration needs separate testkit compatibility review; track #839.
  )

  object test extends ScalaTests with build.XLTestModule {
    override def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.3.6",
      mvn"org.scalacheck::scalacheck:1.20.0"
    )
  }
}

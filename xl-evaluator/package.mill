package build.`xl-evaluator`

import mill._
import mill.scalalib._

object `package` extends build.XLModule {
  override def artifactDescription = "XL Evaluator - Formula parser and evaluator with GADT-based AST"

  override def moduleDeps = Seq(build.`xl-core`)

  override def mvnDeps = Seq(
    mvn"org.typelevel::cats-core:2.12.0"
  )

  object test extends ScalaTests with build.XLTestModule {
    // Share the real-file fixture corpus (xl-ooxml/test/resources/fixtures) so the GH-419
    // DataTableSeeder oracle reads the exact Excel-authored files (resources travel on the
    // test classpath via moduleDeps, same pattern as xl-cats-effect).
    override def moduleDeps = super.moduleDeps ++ Seq(build.`xl-ooxml`.test)

    override def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.0.3",
      mvn"org.scalameta::munit-scalacheck:1.2.0",
      mvn"org.scalacheck::scalacheck:1.18.1"
    )
  }

  /**
   * #767 recalculation benchmark: the synthetic loads-book generator, its oracle samples, the
   * counter gates and the `LoadsBookMain` harness. `__.test` does not select it (the module is not
   * named `test`); CI runs it in the non-blocking `perf` job with
   * `./mill -i xl-evaluator.perf.testForked`. The heap ceiling is the memory gate; `XL_PERF_HEAP`
   * raises it for a manual run of a larger shape (default 2g).
   */
  object perf extends ScalaTests with build.XLTestModule {
    override def moduleDir = super.moduleDir / os.up / "test-perf"

    // Excel.write for the `mode=checked` harness run (what Excel.writeChecked does)
    override def moduleDeps = super.moduleDeps ++ Seq(build.xl)

    override def forkArgs = Task {
      val heap = Task.env.getOrElse("XL_PERF_HEAP", "2g")
      super.forkArgs() ++ Seq(
        s"-Xmx$heap",
        s"-Xms$heap",
        "-XX:+ExitOnOutOfMemoryError",
        "-XX:ActiveProcessorCount=2",
        "-Dxl.perf=true"
      )
    }

    override def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.0.3"
    )
  }
}

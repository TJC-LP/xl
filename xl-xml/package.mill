package build.`xl-xml`

import mill._
import mill.scalalib._

object `package` extends build.XLModule {
  override def artifactDescription =
    "XL XML - Portable OOXML-tuned pull parser and streaming writer"

  // Deliberately zero moduleDeps and zero mvnDeps: this module is the portable XML engine
  // (ADR-016 wave A2) and must stay dependency-free so the Native/JS cross legs (track B)
  // can adopt it without any platform or library baggage. java.lang + scala stdlib only.

  object test extends ScalaTests with build.XLTestModule {
    override def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.0.3",
      mvn"org.scalameta::munit-scalacheck:1.2.0",
      mvn"org.scalacheck::scalacheck:1.18.1"
    )
  }
}

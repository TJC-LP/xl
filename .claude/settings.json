{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mill:*)",
      "Bash(make build:*)",
      "Bash(make install-jar:*)",
      "Bash(make examples:*)",
      "Bash(scripts/test-examples.sh:*)",
      "Bash(scripts/verify-skill-snippets.sh:*)",
      "Bash(scripts/remote-setup.sh:*)",
      "Bash(scala-cli:*)",
      "Bash(xl:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/remote-setup.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}

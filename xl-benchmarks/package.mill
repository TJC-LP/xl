package build.`xl-benchmarks`

import mill._
import mill.scalalib._

object `package` extends build.XLInternalModule with contrib.jmh.JmhModule {
  def jmhCoreVersion = "1.35"

  override def moduleDeps = Seq(
    build.`xl-core`,
    build.`xl-ooxml`,
    build.`xl-cats-effect`,
    // #767 RecalcBenchmark: the LoadsBook generator lives in the evaluator's perf module
    build.`xl-evaluator`.perf
  )

  override def mvnDeps = super.mvnDeps() ++ Seq(
    mvn"org.apache.poi:poi-ooxml:5.2.5" // pinned: Benchmark comparability to POI 5.2.5 is intentional; evaluate 6.x in a separate benchmark baseline (#839).
  )
}
